{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saber.local/schemas/exchange/v1/cax.schema.json",
  "x-saber-version": "1.0.0",
  "title": "Canonical Agent Exchange record",
  "description": "Imported external-agent transcript record with recomputable evidence: a hash chain from raw source bytes through per-entry digests to the record digest. Imported content is untrusted evidence (INV-02).",
  "type": "object",
  "required": ["record_id", "schema_version", "tenant", "workspace", "source", "session", "entries", "record_digest"],
  "additionalProperties": false,
  "properties": {
    "record_id": { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$" },
    "schema_version": { "const": "1.0.0" },
    "tenant": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": {
      "type": "object",
      "required": ["origin_uri", "format", "raw_digest"],
      "additionalProperties": false,
      "properties": {
        "origin_uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "format": { "enum": ["jsonl_transcript", "markdown_transcript"] },
        "raw_digest": { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$" }
      }
    },
    "session": {
      "type": "object",
      "required": ["agent", "session"],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": ["string", "null"], "maxLength": 128 },
        "session": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["content_digest", "role", "content", "occurred_at_ms"],
        "additionalProperties": false,
        "properties": {
          "content_digest": { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$" },
          "role": { "enum": ["user", "assistant", "tool", "system"] },
          "content": { "type": "string", "minLength": 1 },
          "occurred_at_ms": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "record_digest": { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$" }
  }
}
