  "principles": [
    {
      "id": "PHL-01",
      "name": "human sovereignty",
      "invariant": "Silence and expired approval never become consent.",
      "organs": ["ORG-02", "ORG-11", "ORG-13"],
      "segments": ["S30", "S34", "S35"],
      "journeys": ["PJ-08", "PJ-12"],
      "negative_tests": ["agent cannot self-approve", "revoked approval cannot be replayed"]
    },
    {
      "id": "PHL-02",
      "name": "stable body replaceable brain",
      "invariant": "Provider state cannot own Goal identity, Policy or Evidence.",
      "organs": ["ORG-01", "ORG-08", "ORG-10"],
      "segments": ["S27", "S29", "S33"],
      "journeys": ["PJ-01", "PJ-02", "PJ-11"],
      "negative_tests": [
        "provider switch cannot erase event lineage",
        "unsupported capability cannot be emulated as success"
      ]
    },
    {
      "id": "PHL-03",
      "name": "armor organism separation",
      "invariant": "External capability and internal evolution use separate authority and rollback paths.",
      "organs": ["ORG-18", "ORG-19"],
      "segments": ["S33", "S34", "S37"],
      "journeys": ["PJ-04", "PJ-07"],
      "negative_tests": ["plugin install cannot write Memory silently", "Skill promotion cannot grant egress"]
    },
    {
      "id": "PHL-04",
      "name": "immune authority",
      "invariant": "Policy Sandbox Secret Egress Audit Update and Recovery outrank every model and plugin.",
      "organs": ["ORG-11", "ORG-12", "ORG-13"],
      "segments": ["S27", "S34", "S37"],
      "journeys": ["PJ-03", "PJ-04", "PJ-08"],
      "negative_tests": ["model cannot disable containment", "renderer cannot forge policy verdict"]
    },
    {
      "id": "PHL-05",
      "name": "causal observability",
      "invariant": "Auditability comes from causal events and evidence, not hidden chain-of-thought.",
      "organs": ["ORG-02", "ORG-07", "ORG-08", "ORG-17"],
      "segments": ["S30", "S31", "S37"],
      "journeys": ["PJ-01", "PJ-05", "PJ-10"],
      "negative_tests": ["completion cannot rely on unrecorded rationale", "audit export excludes hidden reasoning"]
    },
    {
      "id": "PHL-06",
      "name": "bounded homeostasis",
      "invariant": "Healing restores a declared healthy state without widening authority or erasing evidence.",
      "organs": ["ORG-12", "ORG-13", "ORG-14", "ORG-16"],
      "segments": ["S31", "S34", "S37"],
      "journeys": ["PJ-04", "PJ-05", "PJ-06"],
      "negative_tests": [
        "failed verification cannot be labeled healed",
        "retry cannot duplicate uncertain external effect"
      ]
    },
    {
      "id": "PHL-07",
      "name": "governed evolution",
      "invariant": "Promotion requires lineage, frozen evaluation, independent verdict, canary and rollback.",
      "organs": ["ORG-17", "ORG-19"],
      "segments": ["S33", "S34", "S37"],
      "journeys": ["PJ-07"],
      "negative_tests": [
        "candidate cannot score its own verdict",
        "E6 cannot bypass protected review",
        "E7 autonomous mutation is forbidden"
      ]
    },
    {
      "id": "PHL-08",
      "name": "reconstructable forgettable memory",
      "invariant": "Structured source records are authoritative and derived indexes can be rebuilt or invalidated.",
      "organs": ["ORG-03", "ORG-04", "ORG-15", "ORG-16"],
      "segments": ["S29", "S33", "S34"],
      "journeys": ["PJ-06", "PJ-07", "PJ-12"],
      "negative_tests": ["vector hit cannot outrank source ACL", "forgotten content cannot remain in derived index"]
    },
    {
      "id": "PHL-09",
      "name": "local-first embodiment",
      "invariant": "Remote storage and execution are explicit Realms and do not acquire key or repository authority.",
      "organs": ["ORG-08", "ORG-11", "ORG-15"],
      "segments": ["S33", "S35", "S36"],
      "journeys": ["PJ-09", "PJ-12"],
      "negative_tests": ["server cannot decrypt client-key payload", "offline work cannot be silently discarded"]
    },
    {
      "id": "PHL-10",
      "name": "plural brains one body",
      "invariant": "Agents share one Policy budget event and evidence authority without majority-vote bypass.",
      "organs": ["ORG-01", "ORG-02", "ORG-08", "ORG-09"],
      "segments": ["S30", "S32", "S37"],
      "journeys": ["PJ-08", "PJ-10"],
      "negative_tests": ["agent quorum cannot override security gate", "cross-task message inherits no capability"]
    },
    {
      "id": "PHL-11",
      "name": "continuity with honest drift",
      "invariant": "Resume binds identity and displays code Realm Policy adapter and knowledge drift before effects.",
      "organs": ["ORG-03", "ORG-08", "ORG-10", "ORG-15"],
      "segments": ["S29", "S33", "S36"],
      "journeys": ["PJ-01", "PJ-11"],
      "negative_tests": ["stale approval cannot survive drift", "missing Realm cannot be inherited from UI focus"]
    },
    {
      "id": "PHL-12",
      "name": "graduated autonomy least action",
      "invariant": "Observation-to-mutation and local-to-external transitions are explicit Core events.",
      "organs": ["ORG-06", "ORG-07", "ORG-09", "ORG-11"],
      "segments": ["S30", "S34", "S35"],
      "journeys": ["PJ-02", "PJ-03", "PJ-08"],
      "negative_tests": ["UI mode cannot widen capability", "read-only hook cannot execute a write"]
    }
  ],
