{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saber.local/schema/control/v1/protocol.schema.json",
  "title": "Saber Local Control Protocol",
  "x-saber-version": "1.0.0",
  "$defs": {
    "ControlMethod": {
      "type": "string",
      "enum": [
        "approval.resolve",
        "changeset.apply",
        "changeset.commit",
        "changeset.prepare",
        "changeset.rollback",
        "core.health",
        "core.initialize",
        "events.subscribe",
        "goal.create",
        "plan.freeze",
        "run.cancel",
        "run.fork",
        "run.pause",
        "run.resume",
        "run.retry",
        "run.start",
        "run.steer"
      ]
    },
    "RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "actor_id", "workspace_id", "deadline_unix_ms"],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "causation_id": {
          "type": ["string", "null"]
        },
        "deadline_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": ["string", "null"]
        }
      }
    },
    "ControlRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "protocol_version", "method", "context", "params"],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "protocol_version": {
          "type": "string",
          "enum": ["1.0.0", "0.1.0"]
        },
        "method": {
          "$ref": "#/$defs/ControlMethod"
        },
        "context": {
          "$ref": "#/$defs/RequestContext"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "ControlError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
